# Deployment configuration for GitHub Pages.
#
# The repo is served from https://zaddywebbuilds.github.io/zeusengineering/,
# so every route and asset needs that prefix.
#
# MOVING TO A CUSTOM DOMAIN: set NEXT_PUBLIC_BASE_PATH to an empty value and
# NEXT_PUBLIC_SITE_URL to the domain. Nothing else in the codebase changes.
NEXT_PUBLIC_BASE_PATH=/zeusengineering
NEXT_PUBLIC_SITE_URL=https://zaddywebbuilds.github.io/zeusengineering
